# ============================================================
# Ghost Interview - environment configuration template
# Copy to .env and fill in real values. Never commit the real .env.
# ============================================================

# --- General ---
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Backend API ---
PORT=5000
MONGO_URI=mongodb://mongo:27017/ghost_interview
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Email (leave blank in dev to log emails to the console instead) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ghost Interview <no-reply@ghostinterview.local>"

# --- Seed scripts (npm run seed, npm run seed:roles) ---
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@ghostinterview.local
ADMIN_PASSWORD=ChangeMe123!

# --- Frontend (Vite reads VITE_ prefixed vars) ---
VITE_API_BASE_URL=/api

# --- Optional production HTTPS (set a public DNS name pointing to this host) ---
PUBLIC_DOMAIN=interview.example.com
