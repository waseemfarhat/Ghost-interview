# Copy to backend/.env for local (non-Docker) development.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_DNS_SERVERS=

MONGO_URI=mongodb://127.0.0.1:27017/ghost_interview

# Optional SRS AI providers. Keep keys server-side; blank values use local fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Leave blank to log emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ghost Interview <no-reply@ghostinterview.local>"

# Used only by `npm run seed`
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@ghostinterview.local
ADMIN_PASSWORD=ChangeMe123!
